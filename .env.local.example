# Image generation (scripts/generate-images.ts). One of the two is enough; OpenRouter wins when both are set.
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Stripe checkout. Use test-mode keys (sk_test_…) until you go live.
# Secret key: Stripe Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…): printed by `stripe listen`, or from the webhook endpoint in the Dashboard.
STRIPE_WEBHOOK_SECRET=

# Show the demo test product in a production build (e.g. a Vercel preview). It always shows in `npm run dev`.
# NEXT_PUBLIC_SHOW_DEMO=1
